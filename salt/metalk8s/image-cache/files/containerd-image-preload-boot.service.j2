# Containerd image preload at boot, generated by MetalK8s
#
# Imports the image cache into containerd once per boot, before the kubelet
# starts, so a node with no registry finds the images of its static Pods.
#
# This is a unit of its own, and not a drop-in on the packaged
# `containerd-image-preload.service`, because that service also runs every
# 10 minutes from its timer. The order and the time limit below only apply
# here, at boot:
# - a kubelet restart later on never waits for a periodic import,
# - a periodic import is not stopped after `TimeoutStartSec`.
#
# `ExecStart` and `EnvironmentFile` match the packaged service, see
# rpm/sources/containerd-image-preload.service in scality/image-cache.
[Unit]
Description=Import the container image cache into containerd before the kubelet
After=containerd.service
# `Wants=` and not the `Requires=` of the packaged service: this unit stays
# active, and `Requires=` would restart it, so run a full import, every time
# containerd is restarted.
Wants=containerd.service
# This only sets the order: the kubelet still starts if the import fails.
# The first periodic import also waits, rather than run at the same time.
Before=kubelet.service containerd-image-preload.service

[Service]
Type=oneshot
# Stays active once done, so it runs once per boot and nothing starts it again.
RemainAfterExit=yes
EnvironmentFile=-/etc/sysconfig/containerd-image-preload
ExecStart=/usr/bin/containerd-image-preload
# Without a limit, a stuck import would keep the kubelet from ever starting.
# Once the limit is reached, the import is stopped and the kubelet starts.
TimeoutStartSec={{ timeout }}

[Install]
WantedBy=multi-user.target
