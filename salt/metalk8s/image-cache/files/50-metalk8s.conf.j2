# Containerd image preload service configuration file generated by MetalK8s
[Unit]
# When the node boots, import the cached images before starting the kubelet,
# so it does not have to pull them from the registry.
# This only sets the order: the kubelet still starts if the import fails, and
# restarting the kubelet does not run an import. It only waits for one that is
# already running.
Before=kubelet.service

[Service]
# Without a limit, a stuck import would keep the kubelet from ever starting.
# Once the limit is reached, the import is stopped and the kubelet starts.
TimeoutStartSec={{ timeout }}
