server {
    listen       {{ listening_address }}:{{ listening_port }};
    server_name  localhost;

    # Without autoindex these directories answer 403, keep them answering
    # 200 for the pod probes (/) and the Salt readiness check (/<saltenv>/)
    location = / {
        default_type text/plain;
        return 200 'OK';
    }
{%- for env, archive in archives.items() | sort(attribute='0') %}

    location = /{{ env }}/ {
        if (!-d {{ archive.path ~ package_path }}) {
            return 404;
        }
        default_type text/plain;
        return 200 'OK';
    }

    location /{{ env }}/ {
        alias {{ archive.path ~ package_path }}/;
        autoindex off;
    }
{%- endfor %}

    include conf.d/*.inc;
}
