server {
    listen       {{ listening_address }}:{{ listening_port }};
    server_name  localhost;

    # Answers the probes.
    location = / {
        return 200;
    }
{%- for env, archive in archives.items() | sort(attribute='0') %}

    location /{{ env }}/ {
        alias {{ archive.path ~ package_path }}/;
        autoindex on;
    }
{%- endfor %}

    include conf.d/*.inc;
}
